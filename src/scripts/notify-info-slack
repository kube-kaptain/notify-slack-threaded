# Slack provider for notify-info. Posts into the deploy thread, opening it if
# this is the first message of the run.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: notify-info-slack <message>" >&2
  echo "Error: message argument required" >&2
  exit 42
fi

message="$*"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=src/scripts/lib/notify-slack.bash
source "${script_dir}/lib/notify-slack.bash"

slack_thread_post "$(slack_prefix Info "")${message}"
