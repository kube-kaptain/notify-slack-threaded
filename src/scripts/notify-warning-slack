# Slack provider for notify-warning. Posts into the deploy thread, opening it
# if this is the first message of the run, then marks the message that opened
# it with a warning sign, so a thread that went on to succeed still shows that
# something needs a look.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: notify-warning-slack <message>" >&2
  echo "Error: message argument required" >&2
  exit 42
fi

message="$*"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=src/scripts/lib/notify-slack.bash
source "${script_dir}/lib/notify-slack.bash"

failed=false
slack_thread_post "$(slack_prefix Warning)${message}" || failed=true
slack_thread_react_for Warning || failed=true
[[ "${failed}" == "false" ]]
